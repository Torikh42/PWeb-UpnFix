# =====================================================================
# UPNFIX: Contoh File Environment (.env.example)
# Salin file ini menjadi .env (untuk lokal) atau .env.docker (untuk Docker)
# =====================================================================

# Database Configuration (Connection String)
# Lokal: mysql://username:password@localhost:3306/database_name
# Docker: mysql://username:password@upnfix-db:3306/database_name
DATABASE_URL=mysql://root:password@localhost:3306/upnfix

# JWT Secret untuk Autentikasi (Ganti dengan string acak dan aman)
JWT_SECRET=your_jwt_secret_key_here_min_32_characters

# Cloudinary Configuration (Ambil dari Dashboard Cloudinary Anda)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
